# Copy to .env. Use a URL-safe password (no @ : / # characters).
POSTGRES_PASSWORD=change-me

# none = no auth (first test only). Use apikey for anything real.
AUTH_MODE=none
# Comma-separated keys, sent by clients in X-API-Key
API_KEYS=

# AVEVA/GeoSCADA gateway. Leave SCADA_URL empty to hold logs in the outbox.
SCADA_URL=
# Example: Bearer <token>
SCADA_AUTH_HEADER=
SCADA_TAG_TEMPLATE={asset}.Calibration.{point}
SCADA_MAX_ATTEMPTS=12
